from django.shortcuts import render, get_object_or_404, redirect
from django.http import HttpResponse, HttpResponseNotFound, Http404
from django.views.generic import ListView, DetailView, CreateView
from django.urls import reverse_lazy
from .models import Sportsman, Sports
from .forms import AddArticleForm

menu = [
    {'title': 'About', 'url_name': 'about'},
    {'title': 'Add article', 'url_name': 'add_article'},
    {'title': 'Contacts', 'url_name': 'contact'},
    {'title': 'Sign in', 'url_name': 'login'},
]

# ---------- 函数视图（保留） ----------
def about(request):
    return render(request, 'sportsmen/about.html', {
        'menu': menu,
        'title': 'About',
        'sport_selected': 0,
    })

def contacts(request):
    return HttpResponse('<h1>Contact information</h1>')

def login(request):
    return HttpResponse('<h1>Log in</h1>')

def contact(request):
    return render(request, 'sportsmen/contact.html', {
        'menu': menu,
        'title': 'Contacts',
        'sport_selected': 0,
    })

def pageNotFound(request, exception):
    return HttpResponseNotFound('<h1>404 - Page Not Found</h1>')

# ---------- 类视图 ----------
class SportsmenHome(ListView):
    model = Sportsman
    template_name = 'sportsmen/index.html'
    context_object_name = 'posts'

    def get_queryset(self):
        return Sportsman.objects.filter(is_published=True)

    def get_context_data(self, **kwargs):
        context = super().get_context_data(**kwargs)
        context['menu'] = menu
        context['sport_selected'] = 0
        context['title'] = 'Main page'
        return context

class SportsmenSport(ListView):
    model = Sportsman
    template_name = 'sportsmen/index.html'
    context_object_name = 'posts'
    allow_empty = False

    def get_queryset(self):
        return Sportsman.objects.filter(
            sport__slug=self.kwargs['sport_slug'],
            is_published=True
        )

    def get_context_data(self, **kwargs):
        context = super().get_context_data(**kwargs)
        context['menu'] = menu
        context['sport_selected'] = context['posts'][0].sport_id
        context['title'] = f'Sport - {context["posts"][0].sport}'
        return context

class ShowPost(DetailView):
    model = Sportsman
    template_name = 'sportsmen/post.html'
    slug_url_kwarg = 'post_slug'
    context_object_name = 'post'

    def get_context_data(self, **kwargs):
        context = super().get_context_data(**kwargs)
        context['menu'] = menu
        context['sport_selected'] = 0
        context['title'] = context['post']
        return context

class AddArticle(CreateView):
    form_class = AddArticleForm
    template_name = 'sportsmen/addarticle.html'
    success_url = reverse_lazy('index')

    def get_context_data(self, **kwargs):
        context = super().get_context_data(**kwargs)
        context['menu'] = menu
        context['title'] = 'Add article'
        return context
